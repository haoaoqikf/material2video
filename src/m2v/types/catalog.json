{
  "schemaVersion": 1,
  "types": [
    {
      "name": "financial-timeseries",
      "description": "金融时间序列与假设投资价值演变",
      "summary": "股票、指数及 crypto 日线材料（含 USD/CNY 历史汇率折算）、假设投资计算、手机竖屏折线画面和完整预演自动验收。",
      "plan": "保留独立金融材料、投资价值计算、专用画面与确定性技术验收。",
      "skillGuide": "[金融时间序列视频](references/financial-timeseries-video.md)：核验行情口径、投资计算并通过完整预演自动验收。",
      "materials": [
        {
          "name": "request",
          "file": "request.json",
          "template": {
            "schemaVersion": 1,
            "originalRequest": "填写研究请求",
            "instrument": {
              "kind": "stock",
              "name": "填写标的",
              "code": "填写代码",
              "market": "填写市场",
              "unit": "USD",
              "listingDate": "YYYY-MM-DD"
            },
            "requestedRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "displayRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "investment": {
              "year": 2020,
              "principal": 100000
            },
            "confirmations": []
          }
        },
        {
          "name": "prices",
          "file": "prices.json",
          "template": {
            "schemaVersion": 3,
            "unit": "USD",
            "priceBasis": "split-adjusted",
            "adjustmentBaseDate": "YYYY-MM-DD",
            "adjustmentDefinition": "仅拆合股调整，不计分红再投资",
            "splitAdjustments": [],
            "expectedTradingDates": [],
            "expectedTradingDatesSource": [],
            "points": [],
            "sources": [],
            "rawSnapshots": []
          }
        },
        {
          "name": "plan",
          "file": "animation-plan.json",
          "template": {
            "schemaVersion": 8,
            "chartType": "line",
            "durationSeconds": 60,
            "fps": 30,
            "canvas": {
              "width": 1080,
              "height": 1920
            },
            "axis": {
              "dateRange": [
                "YYYY-MM-DD",
                "YYYY-MM-DD"
              ],
              "dateScale": "staged-expanding",
              "valueScale": "revealed-linear"
            },
            "segments": []
          }
        }
      ]
    },
    {
      "name": "article-narrative",
      "description": "一分钟以内的 v5 多幕文章讲解",
      "summary": "v5 旁白驱动的观点、对比、步骤、因果图和图片讲解，真实语音同步、深浅主题与可选画面评审，成片不超过 60 秒。",
      "plan": "以五种受控讲解模板制作 v5 多幕文章视频，保留真实配音、输入语义审查与完整预演自动验收和可选画面评审。",
      "skillGuide": "[文章生成分镜](references/article-to-storyboard.md)、[分镜结构](references/storyboard-schema.md)、[制作流程](references/production-workflow.md)：v5 多幕卡片与真实语音时间轴。",
      "materials": [
        {
          "name": "storyboard",
          "file": "storyboard.json",
          "template": {
            "version": 5,
            "schemaVersion": 5,
            "fps": 30,
            "width": 1080,
            "height": 1920,
            "title": "新作品",
            "visual": {
              "theme": "dark"
            },
            "scenes": [
              {
                "id": "opening",
                "template": "point",
                "content": {
                  "title": "填写核心观点",
                  "summary": {
                    "text": "填写画面摘要",
                    "segmentId": "opening-line"
                  }
                },
                "narrationSegments": [
                  {
                    "id": "opening-line",
                    "text": "填写完整旁白。"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "general",
      "description": "多场景通用视频编排",
      "summary": "受控图文场景、金融/文章完整片段及作品级 React 场景的多场景时间轴。首版 1080×1920、30 fps，支持硬切、交叉淡化、可选口播与本地音床。",
      "plan": "以帧为单位编排受控图文、完整专用类型片段与受约束 React 场景，统一处理场景边界、转场、逐场景口播与可选本地音床、字幕。",
      "skillGuide": "按独立的 `general-plan.json` 组合受控图文、完整金融/文章片段及公开 React code scene。",
      "materials": [
        {
          "name": "plan",
          "file": "general-plan.json",
          "template": {
            "schemaVersion": 1,
            "fps": 30,
            "width": 1080,
            "height": 1920,
            "scenes": [
              {
                "id": "opening",
                "type": "graphic",
                "duration": {
                  "frames": 90
                },
                "data": {
                  "title": "标题",
                  "body": "编辑 general-plan.json"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "housing-timeseries",
      "description": "年度住宅销售均价变化",
      "summary": "年度住宅销售均价动态折线视频，保存原始销售额、面积与来源口径，输出无声竖屏成片。",
      "plan": "面向住宅年度均价的独立时间序列类型，含材料复算校验、确定性画面与可选画面评审。",
      "skillGuide": "按 `series.json` 提供连续年度住宅销售额、面积、计算均价与来源口径；生成 1080×1920、30 fps 无声折线视频。",
      "materials": [
        {
          "name": "series",
          "file": "series.json",
          "template": {
            "schemaVersion": 1,
            "city": "填写城市",
            "metric": "住宅商品房平均销售价格",
            "unit": "元/平方米",
            "areaUnit": "万平方米",
            "salesAmountUnit": "亿元",
            "formula": "salesAmountYiYuan / salesAreaWanSquareMeters * 10000",
            "durationSeconds": 30,
            "calculationPrecisionNote": "来源公布的销售额和面积精确至 0.1 单位，计算均价受舍入影响。",
            "methodologyNote": "填写统计口径与局限。",
            "sources": [
              {
                "title": "数据来源标题",
                "url": "https://example.org/source"
              }
            ],
            "breakpoints": [],
            "points": [
              {
                "year": 2002,
                "salesAreaWanSquareMeters": 100,
                "salesAmountYiYuan": 20,
                "averagePriceYuanPerSquareMeter": 2000
              }
            ]
          }
        }
      ]
    },
    {
      "name": "stock-montage",
      "description": "在线图库素材的自动检索与剪辑",
      "summary": "按主题与逐幕关键词从在线图库检索并下载素材，留证来源、作者与许可后自动剪成竖屏短片，支持可选口播、字幕与本地音床。",
      "plan": "以一份 brief 驱动在线素材检索、许可留证与自动剪辑，完整预演自动验收，可选评审画面质量与来源合规。",
      "skillGuide": "[在线素材剪辑](references/stock-montage-video.md)：先执行 `m2v stock search` 检索并留证素材，再校验、完整预演与导出。",
      "materials": [
        {
          "name": "brief",
          "file": "brief.json",
          "template": {
            "schemaVersion": 1,
            "topic": "填写主题",
            "targetSeconds": 24,
            "fps": 30,
            "width": 1080,
            "height": 1920,
            "durationToleranceSeconds": 2,
            "provider": {
              "name": "pexels",
              "apiBase": "https://api.pexels.com",
              "apiKeyEnv": "M2V_PEXELS_API_KEY",
              "orientation": "portrait",
              "perPage": 15,
              "media": [
                "video",
                "photo"
              ],
              "minClipSeconds": 2.5,
              "maxClipSeconds": 8,
              "allowReuse": false,
              "aspectRatio": "canvas",
              "aspectRatioTolerance": 0.02
            },
            "visual": {
              "theme": "dark",
              "attribution": "素材来源：Pexels"
            },
            "motion": {
              "photoZoom": 1.12
            },
            "scenes": [
              {
                "id": "opening",
                "keywords": [
                  "填写第一幕检索关键词"
                ],
                "transition": {
                  "type": "cut"
                }
              },
              {
                "id": "development",
                "keywords": [
                  "填写第二幕检索关键词"
                ],
                "transition": {
                  "type": "crossfade",
                  "frames": 12
                }
              },
              {
                "id": "turn",
                "keywords": [
                  "填写第三幕检索关键词"
                ],
                "transition": {
                  "type": "crossfade",
                  "frames": 12
                }
              },
              {
                "id": "closing",
                "keywords": [
                  "填写第四幕检索关键词"
                ],
                "transition": {
                  "type": "cut"
                }
              }
            ]
          }
        }
      ]
    }
  ]
