              "name": "填写标的",
              "code": "填写代码",
              "market": "填写市场",
              "unit": "USD",
              "listingDate": "YYYY-MM-DD"
            },
            "requestedRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "displayRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "investment": {
              "year": 2020,
              "principal": 100000
            },
            "confirmations": []
          }
        },
        {
          "name": "prices",
          "file": "prices.json",
          "template": {
            "schemaVersion": 3,
            "unit": "USD",
            "priceBasis": "split-adjusted",
            "adjustmentBaseDate": "YYYY-MM-DD",
            "adjustmentDefinition": "仅拆合股调整，不计分红再投资",
            "splitAdjustments": [],
            "expectedTradingDates": [],
            "expectedTradingDatesSource": [],
            "points": [],
            "sources": [],
            "rawSnapshots": []
          }
        },
        {
          "name": "plan",
          "file": "animation-plan.json",
          "template": {
            "schemaVersion": 8,
            "chartType": "line",
            "durationSeconds": 60,
            "fps": 30,
            "canvas": {
              "width": 1080,
              "height": 1920
            },
            "axis": {
              "dateRange": [
                "YYYY-MM-DD",
