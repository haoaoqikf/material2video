{
  "schemaVersion": 1,
  "types": [
    {
      "name": "financial-timeseries",
      "description": "金融时间序列与假设投资价值演变",
      "summary": "股票、指数及 crypto 日线材料（含 USD/CNY 历史汇率折算）、假设投资计算、手机竖屏折线画面和完整候选自动验收。",
      "plan": "保留独立金融材料、投资价值计算、专用画面与确定性技术验收。",
      "skillGuide": "[金融时间序列视频](references/financial-timeseries-video.md)：核验行情口径、投资计算并通过完整候选自动验收。",
      "materials": [
        {
          "name": "request",
          "file": "request.json",
          "template": {
            "schemaVersion": 1,
            "originalRequest": "填写研究请求",
            "instrument": {
              "kind": "stock",
              "name": "填写标的",
              "code": "填写代码",
              "market": "填写市场",
              "unit": "USD",
              "listingDate": "YYYY-MM-DD"
            },
            "requestedRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "displayRange": [
              "YYYY-MM-DD",
              "YYYY-MM-DD"
            ],
            "investment": {
              "year": 2020,
              "principal": 100000
            },
            "confirmations": []
          }
        },
        {
          "name": "prices",
          "file": "prices.json",
          "template": {
            "schemaVersion": 3,
            "unit": "USD",
            "priceBasis": "split-adjusted",
            "adjustmentBaseDate": "YYYY-MM-DD",
            "adjustmentDefinition": "仅拆合股调整，不计分红再投资",
            "splitAdjustments": [],
            "expectedTradingDates": [],
            "expectedTradingDatesSource": [],
            "points": [],
            "sources": [],
            "rawSnapshots": []
          }
        },
        {
          "name": "plan",
          "file": "animation-plan.json",
          "template": {
            "schemaVersion": 8,
            "chartType": "line",
            "durationSeconds": 60,
            "fps": 60,
            "canvas": {
              "width": 1080,
              "height": 1920
            },
            "axis": {
              "dateRange": [
                "YYYY-MM-DD",
                "YYYY-MM-DD"
              ],
              "dateScale": "staged-expanding",
              "valueScale": "revealed-linear"
            },
            "segments": []
          }
        }
      ]
    },
    {
      "name": "general",
      "description": "通用",
      "summary": "v8 全画布代码场景讲解：作品自行设计横屏或竖屏画面的配色、构图与动效，支持原文或主题输入、带来源留证的媒体导入、内置音效与本地音床，成片最长 600 秒。",
      "plan": "以本地 React 代码场景制作 v8 全画布讲解视频，默认横屏并支持显式竖屏，保留真实配音、输入语义审查与完整候选自动验收。",
      "skillGuide": "[作品视觉设计与制作流程](references/production-workflow.md)、[分镜结构](references/storyboard-schema.md)、[媒体素材与音效](references/article-media-and-sound.md)、[代码场景契约](references/code-scene-runtime.md)：v8 全画布代码场景多幕讲解。",
      "materials": [
        {
          "name": "storyboard",
          "file": "storyboard.json",
          "template": {
            "version": 8,
            "schemaVersion": 8,
            "fps": 30,
            "width": 1920,
            "height": 1080,
            "title": "新作品",
            "input": {
              "kind": "article"
            },
            "targetSeconds": 60,
            "scenes": [
              {
                "id": "opening",
                "template": "code",
                "content": {
                  "title": "开场",
                  "entry": "scenes/opening.tsx",
                  "props": {}
                },
                "narrationSegments": [
                  {
                    "id": "opening-line",
                    "text": "填写完整旁白。"
                  }
                ]
              }
            ]
          }
        }
      ],
      "starters": [
        "scenes/opening.tsx"
      ]
    },
    {
      "name": "housing-timeseries",
      "description": "年度住宅销售均价变化",
      "summary": "年度住宅销售均价动态折线视频，保存原始销售额、面积与来源口径，输出无声竖屏成片。",
      "plan": "面向住宅年度均价的独立时间序列类型，含材料复算校验、确定性画面与可选画面评审。",
      "skillGuide": "按 `series.json` 提供连续年度住宅销售额、面积、计算均价与来源口径；生成 1080×1920、60 fps 无声折线视频。",
      "materials": [
        {
          "name": "series",
          "file": "series.json",
          "template": {
            "schemaVersion": 1,
            "city": "填写城市",
            "metric": "住宅商品房平均销售价格",
            "unit": "元/平方米",
            "areaUnit": "万平方米",
            "salesAmountUnit": "亿元",
            "formula": "salesAmountYiYuan / salesAreaWanSquareMeters * 10000",
            "durationSeconds": 30,
            "calculationPrecisionNote": "来源公布的销售额和面积精确至 0.1 单位，计算均价受舍入影响。",
            "methodologyNote": "填写统计口径与局限。",
            "sources": [
              {
                "title": "数据来源标题",
                "url": "https://example.org/source"
              }
            ],
            "breakpoints": [],
            "points": [
              {
                "year": 2002,
                "salesAreaWanSquareMeters": 100,
                "salesAmountYiYuan": 20,
                "averagePriceYuanPerSquareMeter": 2000
              }
            ]
          }
        }
      ]
    }
  ]
}
