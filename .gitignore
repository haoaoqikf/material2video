# Dependencies and environments
node_modules/
.venv/
venv/

# Build output and caches
dist/
build/
.cache/
.next/
.pytest_cache/
.pytest-tmp/
__pycache__/
*.py[cod]
*.tsbuildinfo
coverage/
*.log

# Frontend workspace (web/)
# `dist/` 已在上面忽略，Remotion 的打包缓存与逐帧缓存也要忽略：
# 它们不含源信息，重建即可，进版本控制只会制造噪音。
.remotion/
web/.remotion/
# 历史代码场景生成目录与误在工作区根运行留下的派生产物：都不含源信息，忽略以防误提交。
web/.gen/
.gen/
# 字体在构建前从 web/src/assets/fonts/ 同步到这里（唯一真源由
# web/src/assets/fonts.json 声明），因此这是生成物：
# 提交它等于让仓库里多出一份 18MB 的重复内容。
web/public/fonts/

# Secrets and local configuration
.env
.env.*
!.env.example
*.local
*.local.*
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Generated renders and media
outputs/
# 作品按视频类型分层；源内容、迁移备份与其下产物均不纳入版本控制。
/videos/
renders/
recordings/
work/
*.mp4
*.webm
*.mov
*.avi
*.wav
*.mp3
# 示例媒体按 `assets/recipe.json` 下载或生成、按摘要校验，不进入普通 Git；
# 公共字体的许可文本仍入库。风格示例媒体位于各风格 examples 子树，按作品分层。
styles/*/examples/*/assets/media/

# 风格示例的合成音效同理：`assets/sound-recipe.json` 是生成配方（入库），
# 生成的 wav 与按摘要索引的 `sound-sources.json` 是产物（不入库），
# 用 `uv run m2v general sounds import --project <示例> --manifest assets/sound-recipe.json` 恢复。
styles/*/examples/*/assets/sound/*
!styles/*/examples/*/assets/sound/*.py
!styles/*/examples/*/assets/sound/LICENSE.md
styles/*/examples/*/assets/sound-sources.json

# 字体二进制不入库：来源、摘要、许可与恢复目标见 fonts/registry.json，
# 执行 `uv run python fonts/fetch.py` 恢复。许可文本仍入库。
fonts/files/
fonts/.cache/
web/src/assets/fonts/*.ttf
web/src/assets/fonts/*.otf
styles/*/assets/*.ttf
styles/*/assets/*.otf

# 参考素材（含抖音下载的视频、图文与留证记录）属于内容，不入库。
# 浏览器 profile 位于 .cache/，已在上面的缓存规则中忽略。
/refs/

# Article content: 文章内容不入库
# 作品目录（`videos/<type>/<slug>/`：材料、专属网页与 outputs）是内容，不进版本控制。
# 想放仓库外时配 M2V_CONTENT_ROOT 或 --content-root 指向内容根。
# 候选稿与用户明确采用的工作副本属于作品内容，不进入 Git；article.md 原文保持不变。
/styles/*/examples/*/article.candidate.md
/styles/*/examples/*/article.accepted.md

# setuptools editable-install metadata
*.egg-info/

# Local editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Playwright MCP 临时页面快照
.playwright-mcp/
