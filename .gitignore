# Dependencies and environments
node_modules/
.venv/
venv/

# Build output and caches
dist/
build/
.cache/
.next/
.pytest_cache/
.pytest-tmp/
__pycache__/
*.py[cod]
*.tsbuildinfo
coverage/
*.log

# Frontend workspace (web/)
# `dist/` 已在上面忽略，Remotion 的打包缓存与逐帧缓存也要忽略：
# 它们不含源信息，重建即可，进版本控制只会制造噪音。
.remotion/
web/.remotion/
# 作品专属画面模块的动态入口：由工具按工作区根生成，路径随内容根变化。
# 生成脚本一律写 `web/.gen/`；根目录的 `.gen/` 只会来自跑错工作目录的
# 旧版脚本，同样忽略以防误提交。
web/.gen/
.gen/
# 字体在构建前从 web/src/assets/fonts/ 同步到这里（唯一真源由
# web/src/assets/fonts.json 声明），因此这是生成物：
# 提交它等于让仓库里多出一份 18MB 的重复内容。
web/public/fonts/

# Secrets and local configuration
.env
.env.*
!.env.example
*.local
*.local.*
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Generated renders and media
outputs/
# 作品按视频类型分层；源内容、迁移备份与其下产物均不纳入版本控制。
/videos/
renders/
recordings/
work/
*.mp4
*.webm
*.mov
*.avi
*.wav
*.mp3
# 原创声音示例的可复用输入；配音、混音、成片与 videos/ 仍全部忽略。
!examples/buffer-smoothing/assets/bed.wav
!examples/buffer-smoothing/assets/drop.wav

# Article content: 文章内容不入库
# 作品目录（`videos/<type>/<slug>/`：材料、专属网页与 outputs）是内容，不进版本控制。
# 想放仓库外时配 M2V_CONTENT_ROOT 或 --content-root 指向内容根。
# 候选稿与用户明确采用的工作副本属于作品内容，不进入 Git；article.md 原文保持不变。
/examples/*/article.candidate.md
/examples/*/article.accepted.md

# setuptools editable-install metadata
*.egg-info/

# Local editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
