{
  "$meta": {"purpose": "视觉原语注册表唯一真源", "version": 5},
  "motionRuntime": {
    "defaultStylePack": "editorial",
    "stableReadingFrames": 12,
    "phases": ["establish", "change", "result", "settle"],
    "stagger": {"minIntervalFrames": 2, "maxIntervalFrames": 12, "defaultIntervalFrames": 4},
    "cameraIntensity": {"min": 0, "max": 1, "default": 0.5}
  },
  "actions": ["establish", "connect", "transfer", "accumulate", "deplete", "transform", "compare", "highlight", "loop", "break", "restore"],
  "stylePacks": {"editorial": {"riseDistance": 36, "transitionSpan": 18}, "cinematic": {"riseDistance": 48, "transitionSpan": 24}, "technical": {"riseDistance": 30, "transitionSpan": 12}, "poetic": {"riseDistance": 24, "transitionSpan": 20}},
  "continuityTransforms": [
    ["flow", "cycle"],
    ["cycle", "timeline"],
    ["timeline", "gauge"]
  ],
  "neutralActions": ["establish", "highlight"],
  "icons": ["arrow", "check", "cross", "spark", "up", "down", "users", "clock", "target", "alert", "lock", "link", "database", "coin"],
  "actionLabels": {
    "establish": "建立对象或关系",
    "connect": "连接两处内容，表达推进或因果",
    "transfer": "把量或注意力从一个对象转移到另一个",
    "accumulate": "累积增长",
    "deplete": "消耗衰减",
    "transform": "改变形态或类别",
    "compare": "并置比较",
    "highlight": "只强调，不改变状态",
    "loop": "形成闭环回路",
    "break": "打断或断开关系",
    "restore": "回到先前状态"
  },
