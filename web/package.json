{
  "name": "material2video-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "material2video 的画面实现：React composition、帧驱动运行时与渲染契约页",
  "scripts": {
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "dev": "node scripts/sync-fonts.mjs && vite",
    "build": "node scripts/sync-fonts.mjs && tsc --noEmit && vite build",
    "studio": "node scripts/sync-fonts.mjs && remotion studio src/index.ts",
    "render": "node scripts/sync-fonts.mjs && remotion render src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@remotion/animation-utils": "4.0.526",
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/layout-utils": "4.0.526",
    "@remotion/noise": "4.0.526",
    "@remotion/paths": "4.0.526",
    "@remotion/player": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@remotion/tailwind-v4": "4.0.526",
    "@tailwindcss/vite": "4.2.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "echarts": "6.1.0",
    "gsap": "3.15.0",
    "motion": "14.3.0",
    "perfect-freehand": "1.2.3",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526",
    "roughjs": "4.6.6",
    "svg-path-properties": "2.2.0",
    "tailwindcss": "4.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
