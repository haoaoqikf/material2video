{
  "schemaVersion": 1,
  "entry": "SKILL.md",
  "stages": [
    {
      "id": "research",
      "guide": "references/stage-research.md"
    },
    {
      "id": "design",
      "guide": "references/stage-design.md"
    },
    {
      "id": "production",
      "guide": "references/stage-production.md"
    }
  ],
  "tasks": [
    {
      "id": "new",
      "guide": "references/stage-research.md",
      "when": "新制作从研究与创意试制开始"
    },
    {
      "id": "revision",
      "guide": "references/video-revision.md",
      "when": "修改已有作品，保留基线并定位影响"
    },
    {
      "id": "review",
      "guide": "references/stage-production.md",
      "when": "试制或终审；读取独立媒体评审契约"
    },
    {
      "id": "diagnose",
      "guide": "references/stage-production.md",
      "when": "排查材料、场景、媒体或证据"
    }
  ],
  "types": {
    "text-motion": "references/stage-design.md",
    "data-evolution": "references/stage-design.md",
    "principle-metaphor": "references/stage-design.md",
    "spatial-3d": "references/stage-design.md",
    "documentary-edit": "references/stage-design.md"
  },
  "conditional": [
    {
      "id": "documentary-social-video",
      "when": "制作营销号式口播、知识解说、观点短视频、人物故事或热点解读；以旁白和真实素材组织主线",
      "guide": "references/documentary-social-video.md"
    },
    {
      "id": "financial-source",
      "when": "分镜实际声明financial-series来源；固定数学模型不触发",
      "guide": "references/financial-timeseries-video.md"
    },
    {
      "id": "construction-source",
      "when": "分镜实际声明construction来源",
      "guide": "references/building-construction-video.md"
    },
    {
      "id": "vehicle-source",
      "when": "分镜实际声明vehicle-model来源",
      "guide": "references/vehicle-showcase-video.md"
    },
    {
      "id": "mechanisms",
      "when": "可选：需要讲解手法灵感或查询已有机制实现入口",
      "guide": "references/scene-design.md#可选讲解机制"
    },
    {
      "id": "storyboard",
      "when": "首次编写或修改分镜结构",
      "guide": "references/storyboard-schema.md"
    },
    {
      "id": "runtime",
      "when": "首次实现场景、字体、相机或遇到运行时问题",
      "guide": "references/code-scene-runtime.md"
    },
    {
      "id": "motion-components",
      "when": "需要使用或修改共享动效组件、文本适配与中文换行、路径形变、遮罩、纯时间图表、时间轴、象形图或波形",
      "guide": "references/code-scene-runtime.md#共享动效组件"
    },
    {
      "id": "troubleshooting",
      "when": "低机位细线、轨道、道具或相机保持段问题",
      "guide": "references/code-scene-runtime.md#按需排错"
    },
    {
      "id": "media",
      "when": "搜集、入片或修改素材声音与许可",
      "guide": "references/article-media-and-sound.md"
    },
    {
      "id": "sourcing",
      "when": "检索、评估、整理外部素材或核对来源台账",
      "guide": "references/material-sourcing.md"
    },
    {
      "id": "voice",
      "when": "存在旁白且首次选音或旁白变化",
      "guide": "references/voice-and-rhythm.md"
    },
    {
      "id": "reference",
      "when": "创作或实质性视听修订建立具体视觉标杆并深入拆解（无论是否采用），或用户要求学习、借鉴参考",
      "guide": "references/reference-video-analysis.md"
    },
    {
      "id": "design-research",
      "when": "研究与创意试制中连接具体标杆、深入研究与本片转化；60 秒及以下作品不做试制样片、直接进入全片制作；局部修订按缺口复用或补查",
      "guide": "references/stage-research.md"
    },
    {
      "id": "risk",
      "when": "首次声明或修改风险、证据、评审计划或完成状态",
      "guide": "references/review-contract.md"
    },
    {
      "id": "isolation",
      "when": "开始任何适用独立评审",
      "guide": "references/subagent-review.md"
    },
    {
      "id": "visual",
      "when": "判定实际表达、文字、关系或视觉问题",
      "guide": "references/visual-review-rubric.md"
    },
    {
      "id": "motion",
      "when": "首次实现运动、时间换算、显式缓动、数据联动或查询采集模式边界",
      "guide": "references/code-scene-runtime.md#运动实现约定"
    },
    {
      "id": "diagnosis",
      "when": "看图发现画面问题、判断形象是否成立、确定主体尺度",
      "guide": "references/visual-review-rubric.md#看图诊断与形象判据"
    },
    {
      "id": "design-template",
      "when": "编写总设计、关键关系与当前结果记录",
      "guide": "references/scene-design.md#总设计模板"
    },
    {
      "id": "review-report",
      "when": "填写独立观察报告",
      "guide": "references/subagent-review.md"
    },
    {
      "id": "production-template",
      "when": "填写推进回退记录",
      "guide": "references/production-workflow.md"
    },
    {
      "id": "inspiration",
      "when": "创作或实质性视听修订前必读；风格与表达方法自选",
      "guide": "references/visual-expression-inspiration.md"
    },
    {
      "id": "native-design-sample",
      "when": "设计试制、先看图片、原生网页样品或扩展外部实现手段",
      "guide": "references/design-samples.md"
    },
    {
      "id": "scene-design",
      "when": "设计、开发或实质修订场景；查询全片/场景模板、详细编排和对应检查",
      "guide": "references/scene-design.md"
    }
  ],
  "ruleOwners": {
    "事实许可": "references/article-media-and-sound.md",
    "字体确定性": "references/code-scene-runtime.md",
    "独立隔离": "references/subagent-review.md",
    "证据完成": "references/review-contract.md",
    "失败回退": "references/production-workflow.md",
    "讲解机制": "references/scene-design.md",
    "实际表达": "references/visual-review-rubric.md",
    "过程证据容量": "references/subagent-review.md",
    "运动实现": "references/code-scene-runtime.md#运动实现约定"
  }
}
