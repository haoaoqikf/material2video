        "entry": "scenes/compound-connect.tsx",
        "props": {
          "screenSubtitles": [
            {
              "startFrame": 10,
              "endFrame": 170,
              "text": "第一刀，只有 8 毫米。\nOne cut. Eight millimeters."
            },
            {
              "startFrame": 196,
              "endFrame": 412,
              "text": "同一滴水，同一块石头，第 100 天。\nSame drop, same stone, day one hundred."
            },
            {
              "startFrame": 436,
              "endFrame": 592,
              "text": "100 刀，一把凿子；第 37 刀滑了。\nOne chisel, one hundred cuts. The 37th slipped."
            },
            {
              "startFrame": 616,
              "endFrame": 712,
              "text": "复利：把产出接回投入；再投入、时间、反馈。\nCompound: output back to input. Reinvest, time, feedback."
            },
            {
              "startFrame": 736,
              "endFrame": 892,
              "text": "每分一次，枝数翻倍：1 到 64。\nEach split doubles: one to sixty-four."
            },
            {
              "startFrame": 916,
              "endFrame": 1072,
              "text": "42 折，厚度会超过地月距离。\n42 folds: past the moon."
            },
            {
              "startFrame": 1096,
              "endFrame": 1222,
              "text": "42 步：4.2 毫米 对 439,804.65 公里。\nSame 42 steps: 4.2 mm vs 439,804.65 km."
            },
            {
              "startFrame": 1292,
              "endFrame": 1348,
              "text": "前10内部45，最后10新增945。\n45 inside, 945 added."
            },
            {
              "startFrame": 1350,
              "endFrame": 1402,
              "text": "21 倍，共 4,950。\n21 times. 4,950 total."
            },
            {
              "startFrame": 1426,
              "endFrame": 1552,
              "text": "棋盘第 64 格，2 的 63 次方粒。\nSquare 64: two to the 63rd."
            },
            {
              "startFrame": 1576,
              "endFrame": 1798,
              "text": "让下一次，接上一次。\nConnect the next to the last."
            }
          ]
        }
      },
