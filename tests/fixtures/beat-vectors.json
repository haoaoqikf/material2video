    {
      "why": "预算恰好等于段数：每段 1 帧，不做任何额外分配",
      "duration": 3,
      "texts": ["甲", "乙", "丙"],
      "expected": [[0, 1], [1, 2], [2, 3]]
    }
  ],
  "scenes": [
