    "pace": "先用一拍把「难度」与「高估」分开，再让圆周转满分两步，打断只用一拍，末幕用两拍把链条反过来并停留结果",
    "scenePlans": {
      "claim": {
        "start": "三张因果卡片围着圆周，圆周暗着，只有「高估启动成本」被点亮，成本读数停在高位",
        "change": "beat-1 把「事情太难」与「高估启动成本」摆到一起对照，成本读数摆到台面上",
        "result": "停下来的原因不是难度，而是对启动成本的估计"
      },
      "loop": {
        "start": "圆周开始转，第一格仍是「高估启动成本」",
        "change": "beat-2 把估计推到「迟迟不启动」，beat-3 让「得不到反馈」亮起、圆周转满（镜头推近）",
        "result": "三者首尾相接，这个圈会自己转很多年"
      },
      "turn": {
        "start": "圆周转满后变暗停住",
        "change": "beat-4 点亮「先开一寸」，镜头向左平移，把注意力从「准备好」移到极小的启动动作",
        "result": "打断循环不需要更大的力量，只需要先开一寸"
      },
      "reverse": {
        "start": "动作卡片亮着，圆周重新亮起，成本读数仍在高位",
        "change": "beat-5 让反馈回到焦点、把读数改到低位，beat-6 让圆周朝反方向转、估计回到焦点（镜头拉回）",
        "result": "估计被真实反馈修正，阻力自己松开"
      }
    }
  },
