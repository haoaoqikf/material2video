  "direction": {
    "keyScenes": {
      "opening": "hesitate",
      "core": "repeat-adjust",
      "climax": "learn"
    },
    "pace": "全片 40 秒四幕：前 10 秒停在无反馈的犹豫，接着 8 秒用第一次投掷建立可观察偏差，中段 12 秒靠落点累积表现高频调整，最后 10 秒拉回全局收束；镜头只在同一张靶面内推近与拉远，节奏由落点数量增长承担，不靠切换画面。",
    "scenePlans": {
      "first-throw": {
        "start": "飞镖从人物手边离手，飞向靶面",
        "change": "落点偏离靶心，靶面留下第一条示意落点",
        "result": "偏差第一次成为可观察、可据以微调的信息"
      },
      "hesitate": {
        "start": "人已在投掷线后，靶面空着，飞镖始终在手",
        "change": "准备动作反复发生，但迟迟没有投掷，靶面不产生任何结果",
        "result": "等待没有反馈，判断只能靠猜——为后面的偏差信息留出对照"
      },
      "learn": {
        "start": "镜头拉回，人物与完整靶面同框",
        "change": "落点连成一条可读的偏差路径，最后一次落点靠近靶心",
        "result": "偏差变成下一次的方向：没中并非白费，它让下次少一点猜测"
      },
      "repeat-adjust": {
        "start": "已有落点保留在靶面上，不被清除",
        "change": "连续投掷新增落点，方向参考既有偏差逐步向靶心收拢",
        "result": "落点分布显出调整方向，区别于盲目重复"
      }
    }
  },
