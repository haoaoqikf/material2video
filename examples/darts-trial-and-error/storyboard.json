            "segmentId": "darts-steps-0"
          },
          {
            "text": "观察偏差",
            "segmentId": "darts-steps-1"
          },
          {
            "text": "调整做法",
            "segmentId": "darts-steps-2"
          }
        ]
      },
      "narrationSegments": [
        {
          "id": "darts-steps-0",
          "text": "先确定你要达到的目标。"
        },
        {
          "id": "darts-steps-1",
          "text": "观察实际结果与目标的差异。"
        },
        {
          "id": "darts-steps-2",
          "text": "根据差异调整下一次的做法。"
        }
      ]
    },
    {
