          "segmentId": "darts-image-0",
          "keywords": [
            "偏差"
          ]
        }
      },
      "narrationSegments": [
        {
          "id": "darts-image-0",
          "text": "飞镖偏向哪里，是调整方向的依据。示意图表达反馈的作用，不代表真实实验数据。"
