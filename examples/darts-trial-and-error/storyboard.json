      "narrationSegments": [
        {
          "id": "darts-point-0",
          "text": "一次偏离目标的尝试，也能告诉我们下一次应该怎么调整。"
        }
      ]
    },
    {
      "id": "darts-steps",
      "template": "steps",
      "content": {
        "title": "让尝试形成循环",
