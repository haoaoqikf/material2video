        "relation": "focus",
        "focus": "number",
        "composition": "center",
        "density": "sparse",
        "tone": "neutral",
        "mode": "chart",
        "claim": "尝试次数先以读数形式站到台面上，刻度尺还空着",
        "showWithoutText": "一个读数分两档往上跳，它下面那把刻度尺四段都还是零",
        "primaryObject": "持续存在的计数器读数与它下方的刻度尺",
