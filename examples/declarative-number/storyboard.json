  "directingBrief": {
    "thesis": "尝试本身不值钱，值钱的是它留下的反馈记录：记录越全，下一次选择越有依据",
    "audienceShift": "从「做了多少次」转向「每次留下了什么可以用在下一次」",
    "emotionalArc": [
      "平静",
      "累积",
      "看见联系",
      "确定"
    ],
    "visualMotif": "同一个计数器读数、同一把刻度尺与同一条三标签回路在四个阶段持续存在",
    "stylePack": "editorial",
    "avoid": [
      "把次数当成成就展示",
      "把反馈说成一次性奖励"
    ]
  },
  "visual": {
    "theme": "light",
    "preset": "keynote"
  },
