  "stages": [
    {
      "id": "pulse",
      "durationInFrames": 240,
      "data": {
        "headline": "平均相同，不等于每刻相同",
        "note": "没有缓冲：出口跟随入口波动",
        "flow": "pulse"
      },
      "visualIntent": {
        "relation": "contrast",
        "focus": "path",
        "composition": "center",
        "density": "sparse",
        "tone": "tense",
        "mode": "metaphor",
        "claim": "输入忽快忽慢时，无缓冲的出口跟着起伏",
        "showWithoutText": "入口管道上的水滴忽快忽慢，出口管道的水滴同步起伏",
        "primaryObject": "持续存在的入口管道、水箱与出口",
        "motionMeaning": "用脉冲水滴把入口波动原样传到出口"
      },
      "narrationSegments": [
        {
          "id": "line-1",
          "text": "平均输入相同，不代表每一刻都相同。水流一阵急、一阵停，直接连通时，出口只能跟着忽快忽慢。",
          "beatId": "beat-1"
        }
      ],
      "beats": [
        {
          "id": "beat-1",
          "action": "connect",
          "targets": [
            "inlet",
            "outlet"
          ],
          "meaning": "把入口波动与出口起伏直接连起来"
        }
      ]
    },
    {
      "id": "buffer",
      "durationInFrames": 255,
      "data": {
        "headline": "加一个水箱",
        "note": "多出来的水先存起来",
        "flow": "fill"
      },
      "visualIntent": {
        "relation": "cause",
        "focus": "shape",
        "composition": "center",
        "density": "balanced",
        "tone": "neutral",
        "mode": "metaphor",
        "claim": "多出来的水先存进水箱，存储把输入与输出分开",
        "showWithoutText": "水流改走水箱，水位从箱底缓慢上升",
        "primaryObject": "持续存在的水箱与上升的水位",
        "motionMeaning": "水位上升说明多出来的水被存住"
      },
      "narrationSegments": [
        {
          "id": "line-2",
          "text": "加一个水箱，多出来的水先存起来；入口变小的时候，再用存水补上。",
          "beatId": "beat-2"
        }
      ],
      "beats": [
        {
          "id": "beat-2",
          "action": "transform",
          "targets": [
            "inlet",
            "tank",
            "outlet"
          ],
          "meaning": "加入存储空间，改变输入到输出的传递方式"
        }
      ]
    },
    {
      "id": "smooth",
      "durationInFrames": 300,
      "data": {
        "headline": "高峰存储 · 低谷补充",
        "note": "出口保持平稳",
        "flow": "cycle"
      },
      "visualIntent": {
        "relation": "sequence",
        "focus": "shape",
        "composition": "center",
        "density": "balanced",
        "tone": "uplifting",
        "mode": "metaphor",
        "claim": "水位先升后降，出口水滴始终均匀",
