      ],
      "beats": [
        {
          "id": "beat-3",
          "action": "accumulate",
          "targets": [
            "inlet",
            "tank"
          ],
          "meaning": "高峰输入被水箱存下来"
        },
        {
          "id": "beat-4",
          "action": "deplete",
          "targets": [
            "tank",
            "outlet"
          ],
          "meaning": "存水补充出口，输出保持稳定"
        }
      ]
    },
    {
      "id": "overload",
      "durationInFrames": 255,
      "data": {
        "headline": "容量有限",
        "note": "长期超载，水位一直上升",
        "flow": "surge"
      },
      "visualIntent": {
        "relation": "cause",
        "focus": "shape",
        "composition": "center",
        "density": "sparse",
        "tone": "tense",
        "mode": "metaphor",
        "claim": "流入长期大于流出时，有限容量最终溢出",
        "showWithoutText": "水位升到箱顶后越过溢出口，水珠沿弧线离开箱体",
