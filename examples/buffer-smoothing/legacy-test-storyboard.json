      "切换成独立文字页",
      "把示意流量写成真实容量数据"
    ]
  },
  "directingBrief": {
    "thesis": "缓冲用有限容量换取时间：吸收短期波动，不增加长期处理能力",
    "audienceShift": "从「平均相同就等于每刻相同」转向理解波动与容量边界",
    "emotionalArc": [
      "困惑",
      "理解",
      "安心",
      "警觉",
      "清醒"
    ],
    "visualMotif": "同一套入口管道、水箱与限流出口在四种输入条件下持续运转",
    "stylePack": "cinematic",
    "avoid": [
      "宣称缓冲可以无限吸收波动",
      "把水位示意读成真实设备参数"
    ]
  },
  "visual": {
    "theme": "dark",
    "preset": "keynote"
  },
  "world": {
    "id": "buffer-world",
    "claim": "有限容量的存储把短期波动与长期处理能力分开",
    "metaphor": "入口管道、水箱与限流出口组成持续运转的缓冲系统",
    "objects": [
