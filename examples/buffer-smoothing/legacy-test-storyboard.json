      ]
    },
    {
      "id": "conclusion",
      "durationInFrames": 240,
      "data": {
        "headline": "缓冲换时间，不换能力",
        "note": "吸收短期波动 · 不增加长期处理能力",
        "flow": "settle"
      },
      "visualIntent": {
        "relation": "collection",
        "focus": "shape",
        "composition": "center",
        "density": "sparse",
        "tone": "decisive",
        "mode": "metaphor",
        "claim": "入口、水箱与出口再次同框，水位停在中段不再上涨",
