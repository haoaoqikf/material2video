        "role": "supporting",
        "description": "忽快忽慢的入口水流与管道"
      },
      {
        "id": "tank",
        "role": "primary",
        "description": "提供有限存储空间、水位可见的水箱"
      },
      {
        "id": "outlet",
        "role": "supporting",
        "description": "受限流约束、输出稳定水流的出口"
      },
      {
        "id": "overflow",
        "role": "annotation",
        "description": "容量上限处的溢出口与溢出水滴"
      }
