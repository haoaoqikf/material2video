  "fps": 30,
  "width": 1080,
  "height": 1920,
  "title": "缓冲区如何吸收波动",
  "visualDirection": {
    "motif": "水箱水位在脉冲输入下先升后降，超载时越过溢出口",
    "compositionBias": "centered",
    "density": "balanced",
    "rhythm": "steady",
