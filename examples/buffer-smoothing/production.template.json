  "direction": {
    "keyScenes": {
      "opening": "pulse",
      "core": "smooth",
      "climax": "overload"
    },
    "pace": "问题快速建立，机制拆解放慢，存储循环分两步，超载结果停留，结尾回扣",
    "scenePlans": {
      "pulse": {
        "start": "管道直通，水箱空着，入口水滴忽快忽慢",
        "change": "入口水滴成串推进又停顿，出口水滴同步起伏（beat-1 把入口波动直连到出口）",
        "result": "平均相同不等于每刻相同"
      },
      "buffer": {
        "start": "水流改走水箱，水位接近箱底",
        "change": "水位随 beat-2 升到约半箱，直通旁路置灰，水箱成为主焦点",
        "result": "存储把输入与输出分开"
      },
      "smooth": {
        "start": "水位约半箱，出口水滴间隔一致",
        "change": "高峰段水位升到接近箱顶，低谷段回落到约六成半，出口始终均匀（beat-3 积累、beat-4 消耗）",
        "result": "存量换来出口平稳"
      },
      "overload": {
        "start": "水位约六成半并持续上升",
        "change": "水位升到箱顶，溢出口出现并落下水滴（beat-5 突破容量）",
        "result": "有限容量不能解决长期超载"
      },
      "conclusion": {
        "start": "水位停在箱顶，镜头拉回全局",
        "change": "水位回落到中段并停住，入口、水箱与出口再次同框（beat-6 恢复稳态）",
        "result": "缓冲换时间，不换处理能力"
      }
    }
  },
