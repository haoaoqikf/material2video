      "content": {
        "title": "缓冲，让快慢衔接",
        "summary": {
          "text": "暂存差异，平滑输出",
          "segmentId": "buffer-point-0",
          "keywords": [
            "平滑"
          ]
        }
      },
      "narrationSegments": [
        {
          "id": "buffer-point-0",
          "text": "生产和消费的速度不一致时，中间的缓冲能暂时承接差异。"
        }
      ]
    },
    {
      "id": "buffer-compare",
      "template": "compare",
      "content": {
        "title": "有缓冲与无缓冲",
        "columns": [
          {
            "title": "直接交接",
            "items": [
              {
                "text": "速度不同就等待",
                "segmentId": "buffer-compare-0"
              }
            ]
          },
          {
            "title": "中间暂存",
            "items": [
              {
                "text": "用存量承接波动",
                "segmentId": "buffer-compare-1"
              }
            ]
          }
        ]
      },
      "narrationSegments": [
        {
          "id": "buffer-compare-0",
          "text": "没有缓冲，消费者必须等待生产者。"
        },
        {
          "id": "buffer-compare-1",
          "text": "有了缓冲，已经产出的内容可以继续消费。"
        }
      ]
    },
    {
      "id": "buffer-cause",
      "template": "cause",
      "content": {
        "title": "缓冲为什么有效",
        "nodes": [
          {
            "id": "producer",
            "text": "生产者",
            "segmentId": "buffer-cause-0"
          },
          {
            "id": "buffer",
            "text": "缓冲区",
            "segmentId": "buffer-cause-0"
          },
          {
            "id": "consumer",
            "text": "消费者",
            "segmentId": "buffer-cause-1"
          }
        ],
        "links": [
          {
            "from": "producer",
            "to": "buffer",
            "text": "先存起来",
            "segmentId": "buffer-cause-0"
          },
          {
            "from": "buffer",
            "to": "consumer",
            "text": "按需取出",
            "segmentId": "buffer-cause-1"
          }
        ]
      },
      "narrationSegments": [
        {
          "id": "buffer-cause-0",
          "text": "生产者先把结果放入缓冲。"
        },
        {
          "id": "buffer-cause-1",
          "text": "消费者再按自己的速度取出。"
        }
      ],
      "transition": "fade"
    },
    {
