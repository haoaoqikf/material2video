      "narrationSegments": [
        { "id": "line-3", "beatId": "count-progress", "text": "里程碑的作用不是宣布抵达，而是把下一步缩小到今天能完成。" },
        { "id": "line-4", "beatId": "count-progress", "text": "进度可数，下一阶就有了形状；走过几级，行动会反过来推着人继续。" }
