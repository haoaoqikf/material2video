    "pace": "先用一拍立起「正常」的总览数字，再用两拍依次点亮分布尾巴与调用链，末幕用两拍收束预算与结论",
    "scenePlans": {
      "overview": {
        "start": "面板四个分区都在待命，只有总览读数亮着，可用率 99.2% 与「正常」徽标并排",
        "change": "beat-1 把「正常」这个数字与整块面板连起来，其余分区保持灰底",
        "result": "总览说正常，但那只覆盖了大多数请求"
      },
      "tail": {
        "start": "分布分区的五个耗时桶还是空的，其余分区开始退到后面",
        "change": "beat-2 让五个桶依次长高、最右一桶用强调色挑出，镜头推近分布分区",
        "result": "平均数藏起慢的那部分，尾巴决定体验"
      },
      "chain": {
        "start": "分布停在结果上，调用链分区还是灰的",
        "change": "beat-3 让四个节点连成三跳，其中一跳明显变粗并标出远高于其他的毫秒数，镜头拉回",
        "result": "耗时不是均匀摊开的，几乎总堆在某一个依赖上"
      },
      "budget": {
        "start": "链路停在结果上，错误预算圆环还是满的",
        "change": "beat-4 让圆环从满环收敛到不足一半、环心读数变小（镜头推近），beat-5 让总览、分布、链路重新点亮、面板外框收尾",
        "result": "预算是一条看得见的线；健康不是一个数字，而是分布、链路和预算同时可见"
      }
    }
