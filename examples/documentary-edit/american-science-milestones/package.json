{
  "name": "american-science-milestones",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "setup": "uv run --frozen python scripts/video.py setup",
    "validate": "uv run --frozen python scripts/video.py validate",
    "preview": "uv run --frozen python scripts/video.py preview",
    "render": "uv run --frozen python scripts/video.py render",
    "qa": "uv run --frozen python scripts/video.py qa",
    "sample": "uv run --frozen python scripts/video.py sample",
    "build": "node scripts/sync-fonts.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "video:prepare": "uv run --frozen python scripts/video.py prepare"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.526",
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/player": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "echarts": "6.1.0",
    "@remotion/animation-utils": "4.0.526"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
